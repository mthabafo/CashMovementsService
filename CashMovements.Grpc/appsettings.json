{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Retry": {
      "MaxRetries": 3,
      "BaseDelay": "00:00:00.200",
      "MaxRetryDuration": "00:00:05",
      "RetryTimeouts": false
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5145",
        "Protocols": "Http2"
      },
      "GrpcWeb": {
        "Url": "http://localhost:5146",
        "Protocols": "Http1"
      }
    }
  }
}
