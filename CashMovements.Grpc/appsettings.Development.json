{
  "ConnectionStrings": {
    "CashMovements": "Server=.;Database=CashMovements;Integrated Security=True;TrustServerCertificate=True"
  },
  "Database": {
    "AutoSetup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
