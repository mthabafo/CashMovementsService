<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CashMovements.Grpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\cash_movements.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.57.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repo's SQL scripts, copied next to the app for Database:AutoSetup (local development only). -->
    <None Include="..\001_schema.sql;..\002_procedures.sql;..\003_seed.sql" Link="Database\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashMovements.Application\CashMovements.Application.csproj" />
    <ProjectReference Include="..\CashMovements.Infrastructure\CashMovements.Infrastructure.csproj" />
  </ItemGroup>

</Project>
