<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <client>
      <!-- Must match the gateway's endpoint and binding in CashMovements.Wcf\App.config. -->
      <endpoint name="LegacyBalance"
                address="net.tcp://localhost:8095/CashMovements/Balance"
                binding="netTcpBinding"
                bindingConfiguration="WindowsTransport"
                contract="CashMovements.Wcf.Contracts.ILegacyBalanceService" />
    </client>

    <bindings>
      <netTcpBinding>
        <binding name="WindowsTransport" openTimeout="00:00:10" sendTimeout="00:00:30">
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
</configuration>
