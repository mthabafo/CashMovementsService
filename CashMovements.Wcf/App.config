<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!-- The CashMovements gRPC service's gRPC-Web (HTTP/1.1) endpoint: Kestrel:Endpoints:GrpcWeb in its appsettings.json. -->
    <add key="GrpcBackendUrl" value="http://localhost:5146" />
    <!-- Deadline for each backend call. -->
    <add key="BackendTimeoutSeconds" value="10" />
    <!-- Console log format: "simple" (readable single lines) or "json" (one object per line, for log collectors). -->
    <add key="LogFormat" value="simple" />
  </appSettings>

  <system.serviceModel>
    <services>
      <service name="CashMovements.Wcf.LegacyBalanceService" behaviorConfiguration="LegacyGateway">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8095/CashMovements/Balance" />
          </baseAddresses>
        </host>
        <!-- The service: net.tcp://localhost:8095/CashMovements/Balance -->
        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="WindowsTransport"
                  contract="CashMovements.Wcf.Contracts.ILegacyBalanceService" />
        <!-- Metadata for clients that generate a proxy (svcutil / Add Service Reference): .../Balance/mex -->
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <netTcpBinding>
        <!-- Encrypted and signed TCP; callers are authenticated with their Windows account. -->
        <binding name="WindowsTransport">
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="LegacyGateway">
          <serviceMetadata />
          <!-- Never send exception details to clients; failures are typed BalanceFaults. -->
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
