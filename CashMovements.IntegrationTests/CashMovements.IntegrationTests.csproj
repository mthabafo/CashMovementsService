<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests:
    - Grpc/: the real gRPC host started in memory (WebApplicationFactory) and called through a generated client,
      with an in-memory repository in place of the database.
    - Repository/: MovementRepository against a real SQL Server, built from the repo's 001/002 scripts.
      Uses the local default SQL Server instance; set CASHMOVEMENTS_TEST_SQLSERVER to use another
      server (see Support/SqlServerFixture.cs).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CS0436: the client below is generated from the same .proto as the server, so its message types also exist in the
      referenced CashMovements.Grpc assembly. The compiler uses the local (client-side) copies, which is what we want.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Grpc.Net.Client" Version="2.57.0" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\CashMovements.Grpc\Protos\cash_movements.proto" GrpcServices="Client" Link="Protos\cash_movements.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same scripts a real deployment runs, copied next to the tests. -->
    <None Include="..\001_schema.sql;..\002_procedures.sql" Link="Database\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashMovements.Domain\CashMovements.Domain.csproj" />
    <ProjectReference Include="..\CashMovements.Infrastructure\CashMovements.Infrastructure.csproj" />
    <ProjectReference Include="..\CashMovements.Grpc\CashMovements.Grpc.csproj" />
  </ItemGroup>

</Project>
