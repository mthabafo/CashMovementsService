<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line client for manual testing of the CashMovements gRPC service.
    It knows the service only through the .proto contract (no reference to the server project), like any external client.
    See README.md for how to run it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CashMovements.Grpc.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.23.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.57.0" />
    <PackageReference Include="Grpc.Tools" Version="2.57.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\CashMovements.Grpc\Protos\cash_movements.proto" GrpcServices="Client" Link="Protos\cash_movements.proto" />
  </ItemGroup>

</Project>
